# band.ai platform connection (the SDK package is still called thenvoi; the
# platform is band.ai — we use the BAND_* names here for clarity and pass
# them explicitly to Agent.create() so the SDK never sees the rename).
BAND_REST_URL=https://app.thenvoi.com
BAND_WS_URL=wss://app.thenvoi.com/api/v1/socket/websocket

# LLM provider key (used by both agents)
ANTHROPIC_API_KEY=
